rules_version = '2';

// Reglas de seguridad de Firestore para Bitácora de Flota.
// Modelo de roles: conductor, supervisor, gerente, administrador.
// Los permisos se resuelven a partir del rol guardado en /users/{uid}.
//
// Revisa y ajusta antes de producción. Estas reglas asumen que el
// documento de perfil de cada usuario existe en /users/{uid}.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return signedIn() ? profile().role : '';
    }
    function isActive() {
      return signedIn() && profile().activo == true;
    }
    function hasRole(roles) {
      return isActive() && (role() in roles);
    }

    // Datos de la empresa (branding). Lectura pública (nombre y logo);
    // solo el administrador puede editar.
    match /config/{id} {
      allow read: if true;
      allow write: if hasRole(['administrador']);
    }

    // Perfiles de usuario
    match /users/{uid} {
      // Cada quien lee su propio perfil; supervisor/gerente/admin leen todos.
      allow read: if signedIn() && (request.auth.uid == uid || hasRole(['supervisor','gerente','administrador']));
      // Solo el administrador crea o edita perfiles y roles.
      allow create, update, delete: if hasRole(['administrador']);
    }

    // Registro de dispositivos (deviceId + último uso). Cualquier usuario
    // activo puede registrar el dispositivo desde el que trabaja.
    match /devices/{deviceId} {
      allow read: if hasRole(['supervisor','gerente','administrador']);
      allow write: if isActive();
    }

    // Camiones y su documentación
    match /trucks/{id} {
      allow read: if isActive();
      allow create, update, delete: if hasRole(['supervisor','administrador']);
    }

    // Checklists de turno
    match /checklists/{id} {
      // Cualquier usuario activo puede leer el historial del camión.
      allow read: if isActive();
      // El conductor crea su propio checklist (uid propio); no se edita luego.
      allow create: if isActive()
                    && request.resource.data.uid == request.auth.uid
                    && hasRole(['conductor','supervisor','administrador']);
      allow update, delete: if hasRole(['administrador']);
    }

    // Bitácora de novedades
    match /bitacora/{id} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.uid == request.auth.uid
                    && hasRole(['conductor','supervisor','administrador']);
      allow update, delete: if hasRole(['administrador']);
    }

    // Cargas de combustible
    match /fuel/{id} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.uid == request.auth.uid
                    && hasRole(['conductor','supervisor','administrador']);
      allow update, delete: if hasRole(['administrador']);
    }

    // Viajes realizados (2 etapas: el dueño puede cerrar el suyo)
    match /trips/{id} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.uid == request.auth.uid
                    && hasRole(['conductor','supervisor','administrador']);
      allow update: if isActive()
                    && (resource.data.uid == request.auth.uid || hasRole(['supervisor','administrador']));
      allow delete: if hasRole(['administrador']);
    }

    // Productos trasladados (lista editable por supervisor/administrador)
    match /products/{id} {
      allow read: if isActive();
      allow create, update, delete: if hasRole(['supervisor','administrador']);
    }

    // Órdenes de taller y costos
    match /orders/{id} {
      allow read: if hasRole(['supervisor','gerente','administrador']);
      allow create, update, delete: if hasRole(['supervisor','administrador']);
    }

    // Fallas descartadas (marcadas por el supervisor/admin)
    match /resolved/{id} {
      allow read: if hasRole(['supervisor','gerente','administrador']);
      allow write: if hasRole(['supervisor','administrador']);
    }

    // Planificación de flota: catálogo de faenas
    match /faenas/{id} {
      allow read: if isActive();
      allow create, update, delete: if hasRole(['supervisor','administrador']);
    }

    // Planificación de flota: programa semanal y asignaciones
    match /plans/{id} {
      allow read: if isActive();
      allow create, update, delete: if hasRole(['supervisor','administrador']);
    }

    // Planificación de flota: imprevistos operacionales
    match /imprevistos/{id} {
      allow read: if isActive();
      // El conductor puede reportar desde el móvil; supervisor/admin gestionan.
      allow create: if isActive();
      allow update, delete: if hasRole(['supervisor','administrador']);
    }
  }
}
